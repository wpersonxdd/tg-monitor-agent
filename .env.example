# ─── Telegram Bot ─────────────────────────────────────────────────────────────
BOT_TOKEN=
OWNER_CHAT_ID=

# ─── Account Pool ─────────────────────────────────────────────────────────────
# Формат: API_ID:API_HASH:session_name  (через запятую если несколько)
ACCOUNT_POOL=12345678:abcdef1234567890:main_session

MAX_CHANNELS_PER_ACCOUNT=450

# ─── Планы ────────────────────────────────────────────────────────────────────
FREE_CHANNEL_LIMIT=5
STARS_PER_EXTRA_CHANNEL=50
TON_PER_EXTRA_CHANNEL=0.5

# ─── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek
RELEVANCE_THRESHOLD=70

# DeepSeek (рекомендуется — дёшево и умно)
# Ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI (альтернатива)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# ─── Internal ─────────────────────────────────────────────────────────────────
DB_PATH=data/bot.db
